{
    "name": "remote-torrent-adder",
    "version": "2.4.1",
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:chrome": "playwright test --config e2e/playwright.config.ts --project=chrome",
        "test:e2e:firefox": "playwright test --config e2e/playwright.config.ts --project=firefox",
        "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "test:it": "playwright test --config test/it/playwright.config.ts --workers=100%",
        "test:it:headed": "playwright test --config test/it/playwright.config.ts --headed",
        "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "lint:firefox:unlisted": "web-ext lint --source-dir dist-prod/firefox-unlisted --self-hosted",
        "audit": "node scripts/audit.ts",
        "verify": "pnpm run typecheck && pnpm run lint && pnpm test",
        "prebuild": "pnpm run verify",
        "build": "pnpm run build:run",
        "build:run": "node scripts/build.ts --browser=chrome",
        "prebuild:prod": "pnpm run verify",
        "build:prod": "pnpm run build:prod:run",
        "build:prod:run": "node scripts/build.ts --browser=chrome --prod",
        "prebuild:firefox": "pnpm run verify",
        "build:firefox": "pnpm run build:firefox:run",
        "build:firefox:run": "node scripts/build.ts --browser=firefox",
        "prebuild:firefox:prod": "pnpm run verify",
        "build:firefox:prod": "pnpm run build:firefox:prod:run",
        "build:firefox:prod:run": "node scripts/build.ts --browser=firefox --prod",
        "build:firefox:unlisted:run": "node scripts/build-unlisted.ts",
        "prebuild:all": "pnpm run verify",
        "build:all": "pnpm run build:all:run",
        "build:all:run": "pnpm run build:run && pnpm run build:firefox:run && pnpm run build:prod:run && pnpm run build:firefox:prod:run && pnpm run build:firefox:unlisted:run",
        "clean": "rimraf dist",
        "clean:prod": "rimraf dist-prod",
        "dev": "pnpm run build:run && concurrently \"pnpm run watch:assets\" \"pnpm run watch:worker\" \"pnpm run watch:content-script\"",
        "dev:popup": "cross-env RTA_TARGET=popup vite",
        "dev:options": "cross-env RTA_TARGET=options vite",
        "dev:firefox": "pnpm run build:firefox:run && web-ext run --source-dir dist/firefox",
        "watch:assets": "node scripts/build.ts --only=assets --watch",
        "watch:worker": "node scripts/build.ts --only=worker --watch",
        "watch:content-script": "node scripts/build.ts --only=content-script --watch"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bencode": "^4.0.0",
        "@types/chrome": "^0.3.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/selenium-webdriver": "^4.35.7",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "buffer": "^6.0.3",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "postcss": "^8.5.31",
        "rimraf": "^6.1.3",
        "selenium-webdriver": "^4.51.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "web-ext": "^10.8.0"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "bencode": "^4.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    }
}
